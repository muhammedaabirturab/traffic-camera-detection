# Copy to .env and edit. Every value is optional; defaults are shown.

# --- models ---
# Rider detector (YOLO fine-tuned on the person_bike dataset). Default: app/models/rider_detector.pt
MODEL_PATH=
# COCO detector for cars/buses/trucks/persons (auto-downloaded by Ultralytics if missing)
COCO_MODEL_PATH=
# Optional helmet-labelled YOLO model. If absent, helmet compliance is reported as "not assessed".
HELMET_MODEL_PATH=
HELMET_CLASS_NAMES=helmet,with helmet,with_helmet
NO_HELMET_CLASS_NAMES=no_helmet,no helmet,without helmet,head

# --- inference ---
CONFIDENCE_THRESHOLD=0.40
IOU_THRESHOLD=0.45
DEVICE=auto            # auto | cpu | 0 (first CUDA GPU)
IMAGE_SIZE=640

# --- confidence bands & rule thresholds ---
HIGH_CONFIDENCE=0.85
MEDIUM_CONFIDENCE=0.65
MIN_VIOLATION_CONFIDENCE=0.50

# --- video ---
VIDEO_FRAME_SKIP=2
VIDEO_MIN_VIOLATION_FRAMES=3
VIDEO_MAX_SECONDS=120

# --- storage / server ---
# Leave empty for data/trafficguard.db, or e.g. sqlite:///data/history.db
DATABASE_URL=
HOST=127.0.0.1
PORT=8000
